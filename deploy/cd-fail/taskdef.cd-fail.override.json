{
  "_comment": "CD FAIL - Ruta B: override de task definition. Reemplaza temporalmente deploy/taskdef.json SOLO para el commit del escenario CD FAIL. El healthCheck apunta a un puerto inexistente (9999), por lo que el task de reemplazo (green) nunca queda healthy y CodeDeploy reporta un fallo real; el task set estable (blue) sigue sano. Revertir a deploy/taskdef.json para recuperar.",
  "family": "blacklist-service",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/__TASK_EXECUTION_ROLE__",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/__TASK_ROLE__",
  "containerDefinitions": [
    {
      "name": "blacklist",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:9999/health || exit 1"],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "environment": [
        { "name": "DB_HOST", "value": "__DB_HOST__" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "__DB_NAME__" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__DB_SECRET__:DB_USER::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__DB_SECRET__:DB_PASSWORD::" },
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__JWT_SECRET__:JWT_SECRET_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blacklist-service",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
