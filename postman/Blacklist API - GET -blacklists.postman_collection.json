  "item": [
    {
      "name": "GET /blacklists/<string:email>",
      "item": [
        {
          "name": "201 - Validar email en blacklist",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('unique_email', `Test.${ts}@Mail.com`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Confirmation value', () => pm.expect(pm.response.json().in_blacklist).to.eql(true));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists/{{unique_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists",
                "{{unique_email}}"
              ]
            },
            "description": "Consulta si el email pasado como parametro se encuentra registrado en la lista negra. El servidor registra la IP de origen y la fecha/hora."
          },
          "response": []
        },
        {
