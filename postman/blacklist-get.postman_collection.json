{
  "info": {
    "name": "Blacklist API - GET /blacklists/<string:email>",
    "description": "Escenarios de prueba del endpoint GET /blacklists/<string:email> del microservicio de lista negra global. Grupo Blue Team.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "GET /blacklists/<string:email>",
      "item": [
        {
          "name": "200 - Email en blacklist",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const email = `Blocked.${ts}@Mail.com`;",
                  "pm.collectionVariables.set('blocked_email', email);",
                  "pm.collectionVariables.set('blocked_email_lower', email.toLowerCase());",
                  "pm.sendRequest({",
                  "  url: `${pm.collectionVariables.get('base_url')}/blacklists`,",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': `Bearer ${pm.collectionVariables.get('token')}`",
                  "  },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({",
                  "      email: email,",
                  "      app_uuid: '6f9619ff-8b86-d011-b42d-00cf4fc964ff',",
                  "      blocked_reason: 'Compliance request'",
                  "    })",
                  "  }",
                  "}, function (err, res) {",
                  "  if (err) { console.log(err); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Email is blacklisted', () => pm.expect(pm.response.json().is_blacklisted).to.eql(true));",
                  "pm.test('Blocked reason matches', () => pm.expect(pm.response.json().blocked_reason).to.eql('Compliance request'));",
                  "pm.test('Email is normalized', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('blocked_email_lower')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/{{blocked_email}}",
              "host": ["{{base_url}}"],
              "path": ["blacklists", "{{blocked_email}}"]
            },
            "description": "Consulta si un email se encuentra en la lista negra. El email se normaliza a minusculas."
          }
        },
        {
          "name": "200 - Email no esta en blacklist",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('free_email', `Free.${ts}@Mail.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Email is not blacklisted', () => pm.expect(pm.response.json().is_blacklisted).to.eql(false));",
                  "pm.test('Blocked reason is null', () => pm.expect(pm.response.json().blocked_reason).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/{{free_email}}",
              "host": ["{{base_url}}"],
              "path": ["blacklists", "{{free_email}}"]
            },
            "description": "Consulta un email que no ha sido agregado a la lista negra."
          }
        },
        {
          "name": "400 - Sin email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error points to email', () => pm.expect(pm.response.json().errors).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/",
              "host": ["{{base_url}}"],
              "path": ["blacklists", ""]
            },
            "description": "El email es un parametro obligatorio de la URL."
          }
        },
        {
          "name": "400 - Email con formato invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error points to email', () => pm.expect(pm.response.json().errors).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/not-an-email",
              "host": ["{{base_url}}"],
              "path": ["blacklists", "not-an-email"]
            },
            "description": "El email debe tener un formato valido."
          }
        },
        {
          "name": "401 - Sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Auth message', () => pm.expect(pm.response.json().msg).to.eql('Missing or invalid token'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/sin.token@mail.com",
              "host": ["{{base_url}}"],
              "path": ["blacklists", "sin.token@mail.com"]
            },
            "description": "Sin header Authorization la solicitud se rechaza."
          }
        },
        {
          "name": "401 - Token invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Auth message', () => pm.expect(pm.response.json().msg).to.eql('Missing or invalid token'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "abc.def.ghi", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/blacklists/token.invalido@mail.com",
              "host": ["{{base_url}}"],
              "path": ["blacklists", "token.invalido@mail.com"]
            },
            "description": "Un token mal formado o firmado con otra clave tambien responde 401."
          }
        }
      ]
    }
  ]
}
